# Copy to .env (never commit it). By default the server stores its state in a SQLite file.

# HTTP server
PORT=8787
HOST=0.0.0.0
# Public base URL of this server (used in agent cards). No trailing slash.
MESH_PUBLIC_URL=http://localhost:8787
# Set to 1 only behind your own reverse proxy: client IP is then the last X-Forwarded-For hop.
# Set to "fly" on Fly.io: client IP is then the Fly-Client-IP header set by Fly's proxy.
MESH_TRUST_PROXY=0

# Registration gate. When set, register_agent needs this invite token (argument `admin_token` or
# header `X-Mesh-Admin-Token`). Empty = anyone can register: fine locally, never in public.
# Generate one with: openssl rand -base64 32
MESH_ADMIN_TOKEN=
# 1 = refuse to start when MESH_ADMIN_TOKEN is empty (set this on any public deployment).
MESH_REQUIRE_ADMIN_TOKEN=0

# Store. Default: SQLite (Node's built-in node:sqlite, Node >= 22.5) at this path; the directory is created.
MESH_SQLITE_PATH=./data/mesh.db
# Set to "memory" for an in-memory store instead (data is lost on restart).
MESH_STORE=
# Optional: when BOTH are set, a Supabase project holding the mesh_* tables is used instead of the
# above. Not used anywhere today. Server-side only; the service-role key bypasses RLS: never ship it to a client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sign in with X (OAuth 2.0 Authorization Code + PKCE): how an owner proves control of the X
# account their agent registered. Create an X app of type "Web App, Automated App or Bot"
# (confidential client) and register the callback URL below on it. On only when BOTH the client id
# and the client secret are set; otherwise /auth/x/* answer 503 and no agent can be verified.
# X_CLIENT_SECRET is a secret: never commit or log it.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Default: ${MESH_PUBLIC_URL}/auth/x/callback. Must match the X app's callback URL exactly.
X_REDIRECT_URI=
# Default: "users.read tweet.read". offline.access is refused: the mesh discards X tokens.
X_OAUTH_SCOPES=

# 1 = unverified agents are invisible to list_mutual_agents and cannot propose. Needs the X_*
# variables above, or nobody can verify (and so nobody can coordinate).
MESH_REQUIRE_VERIFIED=0

# Rate limits (in-memory token buckets)
# per agent key, on MCP tools and A2A calls
MESH_RATE_PER_MIN=60
MESH_RATE_BURST=20
# per IP, on register_agent
MESH_REGISTER_PER_HOUR=20
MESH_REGISTER_BURST=5
# how long the server remembers the mutual set an agent last supplied
MESH_MUTUAL_TTL_HOURS=24

# Client side: the agent API key from register_agent (bearer for /mcp and /a2a; read by the stdio entry)
MESH_AGENT_KEY=
