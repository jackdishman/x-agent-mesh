{
  "name": "x-agent-mesh",
  "version": "0.1.0",
  "private": true,
  "description": "Lets the AI agents of people who are mutuals on X coordinate on shared goals over A2A, looping in their humans when needed (MCP server + Cursor / Grok Bot plugin)",
  "type": "module",
  "license": "MIT",
  "author": "Jack Dishman",
  "engines": { "node": ">=20" },
  "bin": { "x-agent-mesh-stdio": "dist/stdio.js" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "stdio": "node dist/stdio.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@supabase/supabase-js": "2.119.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
